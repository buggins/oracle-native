    name "tzregions"
    dependency "oracle-native" path=".."
+/
/++
Generates `source/oracle/types/tzregions.d`: the time zone region IDs that
TIMESTAMP WITH TIME ZONE values carry, with their names. For each name in
`V$TIMEZONE_NAMES` it reads `FROM_TZ(TIMESTAMP '2000-01-01 00:00:00', name)`
and takes the ID from the value's last two bytes.

    dub run --single tools/tzregions.d -- <connection string> <user> <password> > source/oracle/types/tzregions.d
+/
module tzregions;

import std.algorithm : sort;
import std.stdio;
import oracle;

int main(string[] args)
{
    if (args.length != 4)
    {
        stderr.writeln("usage: tzregions <connection string> <user> <password>");
        return 2;
    }
    auto conn = new Connection(args[1], args[2], args[3]);
    scope (exit)
        conn.close();
    auto versionResult = conn.query("SELECT version FROM v$timezone_file");
    const fileVersion = versionResult.front.getString(0);
    versionResult.close();
    string[ushort] names;
    foreach (row; conn.query("SELECT tzname, FROM_TZ(TIMESTAMP '2000-01-01 00:00:00', tzname)"
            ~ " FROM (SELECT DISTINCT tzname FROM v$timezone_names) ORDER BY tzname"))
    {
        const b = row.getBytes(1);
        if (b.length != 13 || (b[11] & 0x80) == 0 || (b[12] & 0x03) != 0)
            throw new Exception("unexpected value for " ~ row.getString(0));
        const id = cast(ushort)(((b[11] & 0x7F) << 6) | (b[12] >> 2));
        if (id in names)
            throw new Exception("region ID " ~ id.to!string ~ " has two names: " ~ names[id] ~ ", " ~ row.getString(0));
        names[id] = row.getString(0);
    }
    auto ids = names.keys;
    ids.sort();
    writeln("/++");
    writeln("Oracle time zone region IDs and names, as TIMESTAMP WITH TIME ZONE values carry them.");
    writeln();
    writefln("Generated by `tools/tzregions.d` from Oracle Database %s (time zone file version %s): %s regions.",
            conn.serverVersion, fileVersion, ids.length);
    writeln();
    writeln("Copyright: Copyright © 2026, Vadim Lopatin");
    writeln("License:   $(LINK2 https://www.boost.org/LICENSE_1_0.txt, Boost License 1.0).");
    writeln("+/");
    writeln("module oracle.types.tzregions;");
    writeln();
    writeln("// dfmt off");
    writeln("/// A region ID and its name.");
    writeln("struct TimeZoneRegion");
    writeln("{");
    writeln("    /// The region ID.");
    writeln("    ushort id;");
    writeln("    /// The region name, e.g. `Europe/Lisbon`.");
    writeln("    string name;");
    writeln("}");
    writeln();
    writeln("/// The regions, sorted by ID.");
    writeln("immutable TimeZoneRegion[] timeZoneRegions = [");
    foreach (id; ids)
        writefln("    TimeZoneRegion(%s, %(%s%)),", id, [names[id]]);
    writeln("];");
    writeln("// dfmt on");
    return 0;
}

import std.conv : to;
